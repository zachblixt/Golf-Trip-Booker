# Copy to .env and fill in. .env is gitignored.
#
# Values here are read literally by `docker run --env-file`. Do not quote them,
# and do not escape a $ in a password. Docker Compose is different: it
# interpolates ${...}, so a literal $ must be written $$ in a compose env file.

# host.docker.internal reaches the host machine from inside a container on
# Docker Desktop. Under compose this becomes the MySQL service name instead.
DB_URL=jdbc:mysql://host.docker.internal:3306/golf_trip_booker
DB_USERNAME=root
DB_PASSWORD=your-mysql-password

# HS256 needs 32+ bytes. Generate with: openssl rand -base64 48
JWT_SECRET=
