# Copy to .env. Compose reads .env automatically from this directory.
#
# Compose interpolates ${...} in this file, so a literal $ in any value must
# be written $$. Avoiding $ entirely is simpler.

# Root password for the MySQL container. This is a throwaway container
# database, unrelated to any MySQL installed on your machine.
MYSQL_ROOT_PASSWORD=change-me

# HS256 needs 32+ bytes. Generate with: openssl rand -base64 48
JWT_SECRET=

# Optional. Leave empty and the app runs exactly as before, with the proposal
# drafting endpoint declining politely. Key from console.anthropic.com.
ANTHROPIC_API_KEY=
